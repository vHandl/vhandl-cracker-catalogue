# Copy to server/.env and change the values.
PORT=4000
# Password for the /admin portal
ADMIN_PASSWORD=change-me
# Long random string used to sign admin login tokens
JWT_SECRET=change-me-to-a-long-random-string
# Where the SQLite file lives (use a persistent disk in production)
DB_PATH=./data/catalogue.db
# Order tokens older than this many days can be reused for new orders
TOKEN_REUSE_DAYS=30
